{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListThisBucketOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::secure-stack-assets-ACCOUNT_ID"
    },
    {
      "Sid": "ReadObjectsInThisBucketOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::secure-stack-assets-ACCOUNT_ID/*"
    }
  ]
}
